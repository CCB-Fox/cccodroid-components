#!{{PREFIX}}/bin/sh
# pdf-tools 自检：typst 生成 2 页中文 PDF → qpdf 拆/合 → pdftotext/mutool 抽字
# → pdftoppm 出图 → pdf-shrink 压缩。不联网，只写 $TMPDIR。
set -eu

fail() { echo "✗ $*" >&2; exit 1; }

for c in typst qpdf pdfinfo pdftotext pdftoppm mutool pdf-shrink; do
  command -v "$c" >/dev/null 2>&1 || fail "找不到 $c"
done

D=$(mktemp -d "${TMPDIR:?TMPDIR 未设置}/pdf-selftest.XXXXXX") || fail "建临时目录失败"
trap 'rm -rf "$D"' EXIT INT TERM

cat > "$D/in.typ" <<'EOF'
#set page(paper: "a5", margin: 1cm)
#set text(font: "Noto Sans CJK SC", size: 10pt)
= 第一页 中文

苹果香蕉。PDF toolbox selftest.

#pagebreak()

= 第二页

Second page, English text.
EOF

TYPST_FONT_PATHS=${TYPST_FONT_PATHS:-/system/fonts} typst compile "$D/in.typ" "$D/two.pdf" >/dev/null 2>&1 \
  || fail "typst 生成测试 PDF 失败"
[ "$(pdfinfo "$D/two.pdf" | awk '/^Pages:/{print $2}')" = "2" ] || fail "生成的 PDF 不是 2 页"

qpdf --split-pages=1 "$D/two.pdf" "$D/part.pdf" || fail "qpdf 拆分失败"
[ -s "$D/part-1.pdf" ] && [ -s "$D/part-2.pdf" ] || fail "qpdf 拆分没得到两个文件"

qpdf --empty --pages "$D/part-1.pdf" "$D/part-2.pdf" -- "$D/merged.pdf" || fail "qpdf 合并失败"
[ "$(pdfinfo "$D/merged.pdf" | awk '/^Pages:/{print $2}')" = "2" ] || fail "合并后的 PDF 不是 2 页"

pdftotext -layout "$D/merged.pdf" - 2>/dev/null | grep -q '苹果香蕉' \
  || fail "pdftotext 没抽出中文（可能是字体或 ToUnicode 问题）"

mutool draw -F txt -o "$D/mutool.txt" "$D/merged.pdf" >/dev/null 2>&1 || fail "mutool 抽文字失败"
grep -q '苹果香蕉' "$D/mutool.txt" || fail "mutool 没抽出中文"

pdftoppm -r 72 -png -f 1 -l 1 "$D/merged.pdf" "$D/page" || fail "pdftoppm 出图失败"
[ -s "$D/page-1.png" ] || fail "pdftoppm 没有生成 PNG"

pdf-shrink "$D/merged.pdf" "$D/shrunk.pdf" --quality ebook >/dev/null 2>&1 || fail "pdf-shrink 压缩失败"
[ -s "$D/shrunk.pdf" ] || fail "pdf-shrink 没有生成输出"
[ "$(pdfinfo "$D/shrunk.pdf" | awk '/^Pages:/{print $2}')" = "2" ] || fail "压缩后的 PDF 页数不对"

echo "===== 总结 ===== qpdf=OK text=OK png=OK mutool=OK shrink=OK"
