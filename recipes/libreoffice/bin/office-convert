#!{{PREFIX}}/bin/bash
# office-convert — 用无头 LibreOffice 转换 Office 文档（cccodroid 的 libreoffice 组件）
#
#   office-convert <输入文件> [目标格式] [输出目录]
#   office-convert --selftest
#
#   目标格式   pdf（默认）/ docx / xlsx / pptx / odt / ods / odp / csv / txt / html / rtf / epub / png …
#             也可以写 LibreOffice 的过滤器全名，例如 pdf:writer_pdf_Export
#   输出目录   不给就写在输入文件旁边
#
# 环境变量：
#   CCODROID_LO_PROFILE  用户配置目录（默认每次调用在 $TMPDIR 下新建一个，用完删掉）
#   CCODROID_LO_KEEP_PROFILE=1  保留配置目录（调试用；配合 CCODROID_LO_PROFILE）
#
# 退出码：0 转换成功；1 转换失败；2 用法不对
set -u

PREFIX="${CCODROID_PREFIX:-${PREFIX:-}}"
[ -n "$PREFIX" ] || PREFIX="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

SOFFICE="$PREFIX/lib/libreoffice/program/soffice"

# ── 自检：证明「装了就能转」，不联网、不碰用户文件 ────────────────────
selftest() {
  local t rc=0 cjk="?" note=""
  t="$(mktemp -d "${TMPDIR:-/tmp}/office-selftest.XXXXXX")" || { echo "✗ 建不了临时目录"; return 1; }
  cat > "$t/t.fodt" <<'FODT'
<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:body><office:text><text:p>cccodroid 转换自检 中文 test</text:p></office:text></office:body>
</office:document>
FODT
  if ! "$SOFFICE" --headless --norestore --nolockcheck --nodefault --nofirststartwizard \
       -env:UserInstallation="file://$t/profile" \
       --convert-to pdf --outdir "$t" "$t/t.fodt" > "$t/log" 2>&1; then
    echo "✗ soffice 退出码非 0："; tail -5 "$t/log" | sed 's/^/    /'; rc=1
  fi
  if [ ! -s "$t/t.pdf" ] || [ "$(head -c 5 "$t/t.pdf")" != "%PDF-" ]; then
    echo "✗ 没有生成合法 PDF"; tail -5 "$t/log" 2>/dev/null | sed 's/^/    /'; rc=1
  else
    echo "✓ 转出 PDF：$(stat -c%s "$t/t.pdf") 字节"
    # 中文靠系统的 fontconfig（/system/fonts 里的 NotoSansCJK）：转出来没带 CJK 字体就是方块
    if command -v pdffonts >/dev/null 2>&1; then
      if pdffonts "$t/t.pdf" 2>/dev/null | tail -n +3 | grep -qi cjk; then cjk="OK"
      else cjk="缺字体"; note="（PDF 里没有 CJK 字体，中文会显示成方块 —— 检查 /system/fonts 有没有 NotoSansCJK）"; fi
    else
      cjk="没测"; note="（没有 pdffonts，跳过字体检查）"
    fi
    [ "$cjk" = "缺字体" ] && note="$note"
  fi
  [ "${CCODROID_LO_KEEP_PROFILE:-}" = "1" ] || rm -rf "$t"
  [ -n "$note" ] && echo "$note"
  if [ $rc -eq 0 ]; then
    echo "===== 总结 ===== 转换=OK 输出=PDF 中文=$cjk"
  else
    echo "===== 总结 ===== 转换=FAIL 输出=无 中文=$cjk"
  fi
  return $rc
}

usage() {
  sed -n '2,15p' "$0" | sed 's/^#\{1,2\} \{0,1\}//'
  exit "${1:-0}"
}

case "${1:-}" in
  --selftest) selftest; exit $? ;;
  -h|--help) usage 0 ;;
  "") usage 2 ;;
esac

[ -x "$SOFFICE" ] || { echo "office-convert: 找不到 $SOFFICE —— libreoffice 组件没装好？" >&2; exit 1; }

IN="$1"
FMT="${2:-pdf}"
OUTDIR="${3:-}"

if [ ! -f "$IN" ]; then
  if [ -d "$IN" ]; then
    echo "office-convert: 这是个目录，要给一个文件：$IN" >&2
  else
    echo "office-convert: 找不到输入文件：$IN" >&2
  fi
  exit 1
fi

# 绝对路径：soffice 自己的 -env / --outdir 都按 cwd 解释，给绝对的省事
IN="$(cd "$(dirname "$IN")" && pwd)/$(basename "$IN")"
[ -n "$OUTDIR" ] || OUTDIR="$(dirname "$IN")"
mkdir -p "$OUTDIR" || { echo "office-convert: 建不了输出目录：$OUTDIR" >&2; exit 1; }
OUTDIR="$(cd "$OUTDIR" && pwd)"

# 目标格式：允许带前导点、大小写随意；带 :（过滤器全名）的原样传给 soffice
FMT="${FMT#.}"
case "$FMT" in
  *:*) : ;;
  *) FMT="$(printf '%s' "$FMT" | tr 'A-Z' 'a-z')" ;;
esac

# ── 用户配置目录 ────────────────────────────────────────────────────
# 默认每次调用新开一个、结束就删：不往 $HOME 里散东西，也不用管并发冲突
# （建一个配置目录只要零点几秒，实测首次转换总共不到 2 秒）。
TMPROF=0
PROF="${CCODROID_LO_PROFILE:-}"
if [ -z "$PROF" ]; then
  PROF="$(mktemp -d "${TMPDIR:-/tmp}/lo-profile.XXXXXX")" || { echo "office-convert: 建不了临时目录" >&2; exit 1; }
  TMPROF=1
fi
mkdir -p "$PROF"

cleanup() {
  if [ "$TMPROF" = 1 ] && [ "${CCODROID_LO_KEEP_PROFILE:-}" != "1" ]; then
    rm -rf "$PROF"
  fi
}
trap cleanup EXIT

BASE="$(basename "$IN")"; BASE="${BASE%.*}"

if ! "$SOFFICE" --headless --norestore --nolockcheck --nodefault --nofirststartwizard \
     -env:UserInstallation="file://$PROF" \
     --convert-to "$FMT" --outdir "$OUTDIR" "$IN" > "$PROF/log" 2>&1; then
  echo "office-convert: soffice 失败：" >&2
  grep -q "no export filter" "$PROF/log" && \
    echo "  目标格式「${FMT%%:*}」LibreOffice 不认。常用：pdf docx xlsx pptx odt ods odp csv txt html rtf epub png" >&2
  tail -10 "$PROF/log" | sed 's/^/  /' >&2
  exit 1
fi

# soffice 出错时也常常返回 0 —— 以「文件真的出来了」为准
produced=""
for cand in "$OUTDIR/$BASE.${FMT%%:*}" "$OUTDIR/$BASE.$(printf '%s' "${FMT%%:*}" | tr 'A-Z' 'a-z')"; do
  [ -s "$cand" ] && { produced="$cand"; break; }
done
if [ -z "$produced" ]; then
  echo "office-convert: soffice 说转换了，但输出目录里没有 $BASE.${FMT%%:*} —— 多半是格式名不对或这个文件它读不了。" >&2
  echo "  （支持 pdf docx xlsx pptx odt ods odp csv txt html rtf epub png 等）" >&2
  tail -10 "$PROF/log" | sed 's/^/  /' >&2
  exit 1
fi

echo "$produced"
