#!{{PREFIX}}/bin/bash
# yosys-run — 按本机能用的方式跑 yosys（cccodroid 的 yosys 组件）
#
#   yosys-run <yosys 的参数…>      和 yosys 一样的用法：-p / -s / -c / -S / 位置上的 .ys 脚本
#   yosys-run --selftest
#   yosys-run --why                只把下面这个坑讲一遍
#
# 为什么非要有它（真机实测，Yosys 0.70）：
#
#   **直接调 yosys，只要走到 abc 就会永远卡住** —— 没有报错、没有超时、一个字都不说。
#   原因在 abc 选可执行文件的方式上（源码在 abc-exe 那个文件里逐行注了）：
#   yosys 拿到的 abc.exe 和它内置的默认值（`<yosys 目录>/yosys-abc`）**字符串相等**时，
#   它走「常驻 ABC 协进程」那条路 —— 本机在这条路上会互等（实测 rc=124，翻 /proc 能看到
#   yosys 一直攥着管道的写端不放）。字符串不等时它改走「把脚本写成临时文件、跑一次就收工」，
#   那条路正常。
#
#   所以这个脚本做的事就一句话：**在用户自己的命令流最前面插一句
#   `scratchpad -set abc.exe <abc-exe>`**（abc-exe 就是那个“另一个字符串”，除转发什么也不做）。
#   插在哪由 yosys 自己的执行顺序决定（kernel/driver.cc:604-668）：
#     · -s / -c 脚本      → 在 -p 命令**之前**跑 → 必须插进脚本文件的开头；
#     · -S（内部是 synth）→ synth 被塞在 passes_commands 最前面，**早于** -p → 改写成等价的
#       `-p "注入; synth"`；
#     · -p 命令           → 插进命令串开头；
#     · 位置上的 .ys       → 同 -s。
#   这样下面这些以前会卡死的写法现在都能直接跑（都实测过）：
#     不带 -noabc 的 synth、synth_gatemate -luttree、synth_ecp5 -noabc9、
#     .ys 里嵌套 script 调 abc、-c（Tcl）里调 synth、-S。
#   只有 `synth_easic` 还是跑不了 —— 但它现在**会明确报错**（要 eTools 的库，本机没有），
#   不是静默卡死；ABC9 那批流程本来就不卡（abcc9 不读 abc.exe），不受影响。
#
# 还有（保持原来的好习惯）：
#   · 编译/综合全程用一个工作目录，退出时整个删掉；
#   · `--selftest` 真跑：综合、写网表、走 ABC、形式等价、上面那几条以前会卡的写法各跑一遍，
#     外加一条「直接调 yosys 仍然会卡」的对照（只提示、不算失败，免得环境不同时误报）。
#
# 退出码：0 成功；2 用法不对；其余是 yosys 自己的退出码。
set -u

PREFIX="${CCODROID_PREFIX:-${PREFIX:-}}"
[ -n "$PREFIX" ] || PREFIX="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

YOSYS="$PREFIX/bin/yosys"
REAL_ABC="$PREFIX/bin/yosys-abc"
ABC_EXE="$PREFIX/share/cccodroid/components/yosys/abc-exe"
TMP="${TMPDIR:-$PREFIX/tmp}"
SELF="$(readlink -f "$0" 2>/dev/null)"; [ -n "$SELF" ] || SELF="$0"

# 本次运行的东西全放一个工作目录里，退出时整个删掉。
WORK="$TMP/yosys-run.$$"
mkdir -p "$WORK" 2>/dev/null
trap '[ -n "${WORK:-}" ] && rm -rf "$WORK"' EXIT

die() { echo "yosys-run: $*" >&2; exit 2; }

script_n=0
inject=""

# abc-exe 正常由组件提供（usr/share/cccodroid/components/yosys/abc-exe）。
# 万一手边没有（比如直接从仓库里跑这个脚本），就临时生成一个同效果的。
ensure_abcexe() {
  if [ -x "$ABC_EXE" ]; then
    return 0
  fi
  ABC_EXE="$WORK/abc-exe"
  {
    echo '#!/bin/sh'
    echo "# 临时生成：让 yosys 的 abc.exe 不等于默认值，从而走一次性调用那条路"
    printf 'exec "%s" "$@"\n' "$REAL_ABC"
  } > "$ABC_EXE"
  chmod +x "$ABC_EXE" 2>/dev/null
  echo "yosys-run: 没找到 $PREFIX/share/cccodroid/components/yosys/abc-exe，本次临时生成一个" >&2
}

# 往用户自己的命令流最前面插的那句
mk_inject() { inject="scratchpad -set abc.exe $ABC_EXE"; }

# ---------- 脚本注入 ----------
inject_ys() {   # 复制成临时脚本 + 第一行注入；把新路径打到 stdout
  local src="$1" tmp
  [ -r "$src" ] || die "读不了脚本文件：$src"
  script_n=$((script_n + 1)); tmp="$WORK/script.$script_n.ys"
  { printf '%s\n' "$inject"; cat "$src"; } > "$tmp"
  printf '%s\n' "$tmp"
}

inject_tcl() {  # Tcl 脚本：第一行加一句 `yosys scratchpad …`
  local src="$1" tmp
  [ -r "$src" ] || die "读不了 Tcl 脚本：$src"
  script_n=$((script_n + 1)); tmp="$WORK/script.$script_n.tcl"
  { printf 'yosys %s\n' "$inject"; cat "$src"; } > "$tmp"
  printf '%s\n' "$tmp"
}

# ---------- selftest ----------
selftest() {
  local d rc fail=0 out rc2
  d="$WORK/selftest"
  mkdir -p "$d" || { echo "建不了临时目录"; return 1; }
  cat > "$d/ctr.v" <<'V'
module ctr(input clk, input rst, output reg [3:0] q);
  always @(posedge clk) q <= rst ? 4'd0 : q + 4'd1;
endmodule
V
  cat > "$d/gold.v" <<'V'
module top(input a, input b, input c, output y);
  assign y = (a & b) | (~a & c);
endmodule
V
  cat > "$d/gate.v" <<'V'
module top(input a, input b, input c, output y);
  wire t1, t2, nb;
  assign nb = ~a;
  assign t1 = a & b;
  assign t2 = nb & c;
  assign y = t1 | t2;
endmodule
V

  echo "· 综合一个 5 行模块：read_verilog → synth -noabc → stat"
  out="$d/stat.txt"
  timeout 180 "$YOSYS" -Q -T -p "read_verilog $d/ctr.v; synth -noabc; stat" </dev/null > "$out" 2>&1
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "  ✗ 综合失败（rc=$rc）"; tail -5 "$out" | sed 's/^/    /'; fail=1
  elif ! grep -qE '\$_S?DFF' "$out"; then
    echo "  ✗ stat 里没有触发器（\$_DFF_*），综合结果不对"; tail -20 "$out" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ stat：$(grep -E '^ +[0-9]+ +\$' "$out" | head -4 | tr -s ' ' | tr '\n' ' ')"
  fi

  echo "· 写门级网表 write_verilog"
  timeout 60 "$YOSYS" -Q -T -p "read_verilog $d/ctr.v; synth -noabc; write_verilog $d/net.v" </dev/null >/dev/null 2>&1
  rc=$?
  if [ $rc -ne 0 ] || [ ! -s "$d/net.v" ]; then
    echo "  ✗ 没写出网表（rc=$rc）"; fail=1
  elif ! head -1 "$d/net.v" | grep -q 'Generated by Yosys'; then
    echo "  ✗ 写出来的东西不像 yosys 网表：$(head -1 "$d/net.v")"; fail=1
  else
    echo "  ✓ net.v $(wc -c < "$d/net.v") 字节"
  fi

  echo "· 显式 abc（单独调，脚本由本脚本注入 abc.exe）"
  timeout 180 "$SELF" -Q -T -p "read_verilog $d/ctr.v; synth -noabc; abc -g AND,OR; stat" </dev/null > "$d/abc.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ abc 卡住了（180 秒超时）—— abc.exe 注入没起作用"; fail=1
  elif [ $rc -ne 0 ]; then
    echo "  ✗ 带 abc 的流程失败（rc=$rc）"; tail -5 "$d/abc.txt" | sed 's/^/    /'; fail=1
  elif ! grep -q 'Executing ABC pass' "$d/abc.txt"; then
    echo "  ✗ 根本没走到 ABC"; fail=1
  else
    echo "  ✓ abc 跑完并正常退出（rc=0）"
  fi

  echo "· 形式等价：两种写法应当被判等价"
  timeout 180 "$YOSYS" -Q -T \
    -p "read_verilog $d/gold.v; prep -top top; rename top gold; design -stash gold" \
    -p "read_verilog $d/gate.v; prep -top top; rename top gate; design -copy-from gold -as gold gold" \
    -p "equiv_make gold gate equiv; hierarchy -top equiv; equiv_simple; equiv_status -assert" \
    </dev/null > "$d/equiv.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ 等价检查超时（180 秒）"; fail=1
  elif [ $rc -ne 0 ] || ! grep -q 'Equivalence successfully proven' "$d/equiv.txt"; then
    echo "  ✗ 没判出等价（rc=$rc）"; tail -5 "$d/equiv.txt" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ Equivalence successfully proven!"
  fi

  echo "· FPGA 流程（synth_ice40，走 ABC9）必须能跑完"
  timeout 180 "$SELF" -p "read_verilog $d/ctr.v; synth_ice40; stat" </dev/null > "$d/ice40.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ synth_ice40 卡住了（ABC9 不该卡）"; fail=1
  elif [ $rc -ne 0 ] || ! grep -qE 'SB_LUT4|Number of cells' "$d/ice40.txt"; then
    echo "  ✗ synth_ice40 跑失败（rc=$rc）"; tail -3 "$d/ice40.txt" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ synth_ice40 跑通（abc9），stat 有单元"
  fi

  # ---------- 下面这些以前会卡死 / 被挡下，现在应当直接跑完 ----------
  echo "· 不带 -noabc 的 synth 直接跑完（这就是这个包装存在的理由）"
  timeout 180 "$SELF" -Q -T -p "read_verilog $d/ctr.v; synth; stat" </dev/null > "$d/plain.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ 还是卡住了 —— abc.exe 注入没起作用"; fail=1
  elif [ $rc -ne 0 ] || ! grep -q 'Executing ABC pass' "$d/plain.txt" || ! grep -qE '\$_S?DFF' "$d/plain.txt"; then
    echo "  ✗ 没跑通（rc=$rc）"; tail -5 "$d/plain.txt" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ 跑完：走了 ABC，stat 里有触发器"
  fi

  echo "· synth_gatemate -luttree / synth_ecp5 -noabc9（都是走 abc 的老卡死点）"
  local g_ok=1
  timeout 180 "$SELF" -Q -T -p "read_verilog $d/ctr.v; synth_gatemate -luttree; stat" </dev/null > "$d/gm.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ] || [ $rc -ne 0 ]; then
    echo "  ✗ synth_gatemate -luttree rc=$rc"; tail -3 "$d/gm.txt" | sed 's/^/    /'; g_ok=0; fail=1
  fi
  timeout 180 "$SELF" -Q -T -p "read_verilog $d/ctr.v; synth_ecp5 -noabc9; stat" </dev/null > "$d/ecp5.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ] || [ $rc -ne 0 ]; then
    echo "  ✗ synth_ecp5 -noabc9 rc=$rc"; tail -3 "$d/ecp5.txt" | sed 's/^/    /'; g_ok=0; fail=1
  fi
  [ $g_ok -eq 1 ] && echo "  ✓ 两条都跑完（rc=0）"

  echo "· .ys 里嵌套 script 调 abc"
  printf 'read_verilog %s\nsynth -noabc\nabc -g AND,OR\nstat\n' "$d/ctr.v" > "$d/inner.ys"
  printf 'script %s\nstat\n' "$d/inner.ys" > "$d/outer.ys"
  timeout 180 "$SELF" -Q -T -s "$d/outer.ys" </dev/null > "$d/nest.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ 嵌套脚本卡住了"; fail=1
  elif [ $rc -ne 0 ] || ! grep -q 'Executing ABC pass' "$d/nest.txt"; then
    echo "  ✗ 嵌套脚本没跑通（rc=$rc）"; tail -3 "$d/nest.txt" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ 跑完（外层 .ys 的一句注入，里层的 abc 也吃到了）"
  fi

  echo "· -c（Tcl）里跑 synth"
  printf 'yosys read_verilog %s\nyosys synth\nyosys stat\n' "$d/ctr.v" > "$d/t.tcl"
  timeout 180 "$SELF" -Q -T -c "$d/t.tcl" </dev/null > "$d/tcl.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ Tcl 那条卡住了"; fail=1
  elif [ $rc -ne 0 ] || ! grep -q 'Executing ABC pass' "$d/tcl.txt"; then
    echo "  ✗ Tcl 那条没跑通（rc=$rc）"; tail -3 "$d/tcl.txt" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ 跑完"
  fi

  echo "· -S（快捷 synth）"
  timeout 180 "$SELF" -Q -T -S "$d/ctr.v" </dev/null > "$d/S.txt" 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✗ -S 卡住了"; fail=1
  elif [ $rc -ne 0 ] || ! grep -q 'Executing ABC pass' "$d/S.txt"; then
    echo "  ✗ -S 没跑通（rc=$rc）"; tail -3 "$d/S.txt" | sed 's/^/    /'; fail=1
  else
    echo "  ✓ 跑完"
  fi

  echo "· 对照：绕过 yosys-run 直接调 yosys 仍然会卡（只提示，不算失败）"
  timeout 15 "$YOSYS" -Q -T -p "read_verilog $d/ctr.v; synth; stat" </dev/null >/dev/null 2>&1
  rc=$?
  if [ $rc -eq 124 ]; then
    echo "  ✓ 确实卡住了（所以本组件要求用 yosys-run，别直接调 yosys）"
  else
    echo "  ⚠ 这次没卡（rc=$rc）—— 环境可能不同，但 yosys-run 仍然是对的做法"
  fi

  echo "===== 总结 ===== $( [ $fail -eq 0 ] && echo '全部通过' || echo '有失败项' )"
  return $fail
}

print_why() {
  cat <<'EOF'
本机的 yosys（Yosys 0.70）**只要走到 abc 就会永远卡住**，没有报错也没有超时；
而 `synth` 默认就会走到 abc。（实测：不带 -noabc 的 synth / synth_gatemate -luttree /
synth_ecp5 -noabc9 / .ys 里嵌套 script 调 abc / -S，直接调 yosys 时全都 rc=124。）

为什么（对着 Yosys 0.70 的源码看过）：
  · abc 选可执行文件时先读设计里的 scratchpad 变量 abc.exe
      passes/techmap/abc.cc:2040  config.exe_file = scratchpad_get_string("abc.exe", yosys_abc_executable)
  · 默认值不是字面量 "yosys-abc"，而是 yosys 自己所在目录下的那一个：
      kernel/yosys.cc:661         yosys_abc_executable = proc_self_dirname() + "yosys-abc"
  · 然后按**字符串相等**选路：
      passes/techmap/abc.cc:147   return exe_file == yosys_abc_executable;
      相等 → 常驻 ABC 协进程（管道协议、复用进程）—— **本机这条会互等卡死**
      不等 → 写个临时脚本、跑一次 `"<exe_file>" -s -f <script>` —— 正常
  · 卡死那条路上，yosys 喂完脚本不关管道写端、也不发 quit，ABC 停在 `abc 07> ` 等下一句，
    两边互等（翻 /proc/<yosys>/fd 能看到它一直攥着那个写端）。不是 seccomp 的事：
    env -u LD_PRELOAD 和 enosys-run 都试过，一样卡。

yosys-run 怎么绕：在**用户自己的命令流最前面**插一句
    scratchpad -set abc.exe <...>/abc-exe
（abc-exe 是个“另一个字符串”，内容就是把参数转给真正的 yosys-abc）。
插的位置由 yosys 的执行顺序决定（kernel/driver.cc:604-668）：
    · -s / -c 脚本 → 在 -p **之前**跑 → 注入写进脚本文件第一行
    · -S          → synth 被塞在 -p **之前** → 改写成等价的 -p "注入; synth"
    · -p          → 注入写进命令串开头
    · 位置上的 .ys → 同 -s

实测（Yosys 0.70，本机，注入之后）：
    不带 -noabc 的 synth         rc=0（走 ABC，stat 有 $_SDFF_*）
    synth_gatemate -luttree      rc=0
    synth_ecp5 -noabc9           rc=0
    .ys 里嵌套 script 调 abc      rc=0
    -c（Tcl）里跑 synth           rc=0
    -S                           rc=0
  ABC9 那批流程（synth_ice40 / ecp5 / gowin / xilinx / intel … 17 条）本来就不卡，
  而且 abc9 不读 abc.exe，不受这里的影响。

还是要注意的：
  · **别绕过 yosys-run 直接调 $PREFIX/bin/yosys** —— 那样没有注入，还是会卡死。
  · `synth_easic` 仍然跑不了，但现在是**明确报错**而不是卡死：
    它要 eTools 的库（`…/opt/eTools/data_ruby28/…lib`，本机没有）。
  · 自己显式写 `abc -exe yosys-abc`（或把 abc.exe 设成那个默认字符串）会退回卡死那条路 ——
    除非你清楚在干什么，否则别动它。
EOF
}

# ---------- 参数处理 ----------
if [ $# -eq 0 ]; then
  echo "yosys-run <yosys 的参数…>   |   yosys-run --selftest   |   yosys-run --why" >&2
  exit 2
fi
ensure_abcexe
mk_inject
case "$1" in
  --selftest) selftest; exit $? ;;
  --why)      print_why; exit 0 ;;
  --help|-h)  awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
esac

declare -a out_args=()
saw_frontend=0
for a in "$@"; do
  case "$a" in -f|--frontend) saw_frontend=1 ;; esac
done

i=1
while [ $i -le $# ]; do
  a="${!i}"
  case "$a" in
    -S|--synth)
      # -S 的 synth 由 driver 塞进 passes_commands 且排在 -p 之前（kernel/driver.cc:391），
      # 注入赶不上它 —— 所以把 -S 换成等价的 -p「注入; synth」。
      out_args+=("-p" "$inject; synth")
      ;;
    -p|--commands)
      i=$((i + 1))
      [ $i -le $# ] || die "$a 后面缺命令串"
      out_args+=("-p" "$inject; ${!i}")
      ;;
    -p*)
      out_args+=("-p" "$inject; ${a#-p}")
      ;;
    -s|--scriptfile)
      i=$((i + 1))
      [ $i -le $# ] || die "$a 后面缺文件名"
      out_args+=("-s" "$(inject_ys "${!i}")")
      ;;
    -s*)
      out_args+=("-s" "$(inject_ys "${a#-s}")")
      ;;
    -c|--tcl-scriptfile)
      i=$((i + 1))
      [ $i -le $# ] || die "$a 后面缺文件名"
      out_args+=("-c" "$(inject_tcl "${!i}")")
      ;;
    -c*)
      out_args+=("-c" "$(inject_tcl "${a#-c}")")
      ;;
    --)   out_args+=("$a"); i=$((i + 1))
          while [ $i -le $# ]; do out_args+=("${!i}"); i=$((i + 1)); done
          break ;;
    -*)
      out_args+=("$a")
      case "$a" in
        -b|--backend|-f|--frontend|-o|-l|--logfile|-m|--plugin|-D|--define|-r|--top|-v|--verbose)
          i=$((i + 1)); out_args+=("${!i:-}") ;;
      esac
      ;;
    *)
      # 位置参数：yosys 自己的规矩是「没给 -f 且以 .ys 结尾」才当脚本，
      # 其它情况（foo.v / foo.blif …）是输入文件，交给 yosys 自己判断。
      case "$a" in
        *.ys)
          if [ $saw_frontend -eq 0 ] && [ -f "$a" ]; then
            out_args+=("$(inject_ys "$a")")
          else
            out_args+=("$a")
          fi
          ;;
        *) out_args+=("$a") ;;
      esac
      ;;
  esac
  i=$((i + 1))
done

"$YOSYS" "${out_args[@]}"
exit $?
